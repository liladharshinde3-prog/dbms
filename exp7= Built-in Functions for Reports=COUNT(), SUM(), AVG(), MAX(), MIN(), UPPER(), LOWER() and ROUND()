CREATE DATABASE IF NOT EXISTS Company;
USE Company;


DROP TABLE IF EXISTS Employee;
CREATE TABLE Employee (
    Employee_ID    INT PRIMARY KEY,
    Employee_Name  VARCHAR(50),
    Department     VARCHAR(30),
    Salary         INT
);


