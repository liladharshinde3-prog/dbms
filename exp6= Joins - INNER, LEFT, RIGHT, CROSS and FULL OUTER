--Step : INNER JOIN - only matching records--

SELECT e.Employee_ID, e.Employee_Name, d.Dept_Name
FROM Employee e
INNER JOIN Department d ON e.Dept_ID = d.Dept_ID
ORDER BY e.Employee_ID;


--Step : LEFT JOIN - all employees + matching departments--

SELECT e.Employee_ID, e.Employee_Name, d.Dept_Name
FROM Employee e
LEFT JOIN Department d ON e.Dept_ID = d.Dept_ID
ORDER BY e.Employee_ID;


--Step : RIGHT JOIN - all departments + matching employees--

SELECT e.Employee_Name, d.Dept_Name
FROM Employee e
RIGHT JOIN Department d ON e.Dept_ID = d.Dept_ID
ORDER BY d.Dept_ID, e.Employee_ID;


--Step : CROSS JOIN - every employee with every department--

SELECT e.Employee_Name, d.Dept_Name
FROM Employee e
CROSS JOIN Department d
ORDER BY e.Employee_ID, d.Dept_ID;

--Step : FULL OUTER JOIN using UNION--

SELECT e.Employee_Name, d.Dept_Name
FROM Employee e
LEFT JOIN Department d ON e.Dept_ID = d.Dept_ID
UNION
SELECT e.Employee_Name, d.Dept_Name
FROM Employee e
RIGHT JOIN Department d ON e.Dept_ID = d.Dept_ID;



